{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "GitHub Actions workflow Renovate rules",
  "extends": [
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "Label GitHub Actions updates. Pin and digest updates automerge from the default preset only after status checks pass.",
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions", "dependencies"]
    },
    {
      "description": "Require review for major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "GitHub Actions major",
      "automerge": false,
      "addLabels": ["major-update", "github-actions", "dependencies"],
      "reviewers": ["matt-riley"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep matt-riley-ci reusable workflow refs pinned to latest main SHA",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "uses:\\s+matt-riley\\/matt-riley-ci\\/(?<depName>\\.github\\/workflows\\/[^@\\s]+)@(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/matt-riley/matt-riley-ci",
      "currentValueTemplate": "main"
    }
  ]
}
