{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "GitHub Actions workflow Renovate rules",
  "extends": [
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "addLabels": ["github-actions", "dependencies"],
      "automerge": true
    },
    {
      "description": "Require review for major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update", "github-actions", "dependencies"],
      "reviewers": ["matt-riley"]
    }
  ]
}
