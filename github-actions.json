{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "GitHub Actions workflow Renovate rules",
  "extends": [
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "addLabels": ["github-actions", "dependencies"],
      "automerge": true
    },
    {
      "description": "Require review for major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update", "github-actions", "dependencies"],
      "reviewers": ["matt-riley"]
    }
  ],
  "regexManagers": [
    {
      "description": "Keep matt-riley-ci reusable workflow refs pinned to latest main SHA",
      "fileMatch": ["^\\.github/workflows/.*\\.ya?ml$"],
      "matchStrings": [
        "uses:\\s+matt-riley\\/matt-riley-ci\\/(?<depName>\\.github\\/workflows\\/[^@\\s]+)@(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "matt-riley/matt-riley-ci",
      "currentValueTemplate": "main"
    }
  ]
}
