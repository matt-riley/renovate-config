{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Terraform/OpenTofu-specific Renovate rules",
  "packageRules": [
    {
      "description": "Mark Terraform-managed updates (adds terraform label additively)",
      "matchManagers": ["terraform"],
      "addLabels": ["terraform"]
    },
    {
      "description": "Label Terraform provider updates. Non-major updates join the weekly batches from the default preset.",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["provider", "required_provider"],
      "matchUpdateTypes": ["minor", "patch", "pin"],
      "addLabels": ["terraform-providers"]
    },
    {
      "description": "Label Terraform module updates. Non-major updates join the weekly batches from the default preset.",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["module"],
      "matchUpdateTypes": ["minor", "patch", "pin"],
      "addLabels": ["terraform-modules"]
    },
    {
      "description": "Review Terraform/OpenTofu runtime version changes manually. Kept out of the weekly automerge batch.",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version", "tfe_workspace"],
      "groupName": "Terraform/OpenTofu runtime",
      "rangeStrategy": "bump",
      "automerge": false,
      "addLabels": ["terraform-runtime"],
      "reviewers": ["matt-riley"]
    }
  ]
}
