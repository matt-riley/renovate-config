{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Node.js/TypeScript-specific Renovate rules",
  "hostRules": [
    {
      "description": "Authenticate Renovate to GitHub Packages for @matt-riley npm packages",
      "matchHost": "npm.pkg.github.com",
      "hostType": "npm",
      "token": "{{ secrets.GITHUB_PACKAGES_TOKEN }}"
    }
  ],
  "npmrc": "@matt-riley:registry=https://npm.pkg.github.com/\n",
  "npmrcMerge": true,
  "packageRules": [
    {
      "description": "Skip release cooldown for @matt-riley npm packages and open PRs immediately",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["/^@matt-riley\\//"],
      "minimumReleaseAge": null,
      "prCreation": "immediate"
    },
    {
      "description": "Label TypeScript and type definitions",
      "matchPackageNames": ["/^@types\\//", "/^typescript/"],
      "addLabels": ["typescript", "dependencies"]
    },
    {
      "description": "Label linting/formatting tools",
      "matchPackageNames": [
        "/^oxlint/",
        "/^oxfmt/",
        "/^eslint/",
        "/^prettier/",
        "/^@typescript-eslint\\//",
        "/^@eslint\\//",
        "/^oxc-/",
        "/^biome/"
      ],
      "addLabels": ["linting", "dependencies"]
    },
    {
      "description": "Label testing frameworks",
      "matchPackageNames": ["/^vitest/", "/^@vitest\\//", "/^jest($|[-/])/", "ts-jest", "jest-junit"],
      "addLabels": ["testing", "dependencies"]
    },
    {
      "description": "Label build tools",
      "matchPackageNames": [
        "pkgroll",
        "tsup",
        "esbuild",
        "/^rollup/",
        "/^vite/"
      ],
      "addLabels": ["build", "dependencies"]
    }
  ]
}
