{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Astro framework-specific Renovate rules",
  "packageRules": [
    {
      "description": "Label Astro core and integrations",
      "matchPackageNames": ["/^astro/", "/^@astrojs\\//"],
      "addLabels": ["astro", "dependencies"]
    },
    {
      "description": "Label CSS/Tailwind packages",
      "matchPackageNames": [
        "/^tailwindcss/",
        "/^@tailwindcss\\//",
        "autoprefixer",
        "cssnano",
        "sass",
        "/^postcss/"
      ],
      "addLabels": ["css", "dependencies"]
    },
    {
      "description": "Label Cloudflare packages",
      "matchPackageNames": ["wrangler", "/^@cloudflare\\//"],
      "addLabels": ["cloudflare", "dependencies"]
    }
  ]
}
