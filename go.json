{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Go-specific Renovate rules. Toolchain updates stay in their own group. Other Go dependencies are labeled here and join the weekly batches from the default preset.",
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Group Go toolchain version updates in mise and asdf with go.mod",
      "matchManagers": ["mise", "asdf"],
      "matchDepNames": ["go", "golang"],
      "groupName": "Go toolchain",
      "addLabels": ["go-toolchain", "dependencies"]
    },
    {
      "description": "Bump and group go.mod go and toolchain directives with toolchain pins",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang", "toolchain"],
      "rangeStrategy": "bump",
      "groupName": "Go toolchain",
      "addLabels": ["go-toolchain", "dependencies"]
    },
    {
      "description": "Label golang.org/x/* packages",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^golang\\.org\\/x\\//"],
      "addLabels": ["go-stdlib", "dependencies"]
    },
    {
      "description": "Label OpenTelemetry Go packages",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^go\\.opentelemetry\\.io\\//"],
      "addLabels": ["observability", "dependencies"]
    },
    {
      "description": "Label Charmbracelet TUI packages",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "/^github\\.com\\/charmbracelet\\//",
        "/^github\\.com\\/muesli\\//",
        "/^github\\.com\\/lucasb-eyer\\//",
        "/^github\\.com\\/aymanbagabas\\//",
        "/^github\\.com\\/mattn\\/go-/"
      ],
      "addLabels": ["tui", "dependencies"]
    },
    {
      "description": "Label go-chi router packages",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^github\\.com\\/go-chi\\//"],
      "addLabels": ["router", "dependencies"]
    },
    {
      "description": "Label Google/gRPC packages",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "/^google\\.golang\\.org\\//",
        "/^cloud\\.google\\.com\\//",
        "/^github\\.com\\/googleapis\\//",
        "/^github\\.com\\/google\\//",
        "/^github\\.com\\/grpc-ecosystem\\//",
        "/^github\\.com\\/cncf\\/xds\\//",
        "/^github\\.com\\/envoyproxy\\//",
        "/^github\\.com\\/planetscale\\//",
        "/^cel\\.dev\\//"
      ],
      "addLabels": ["google", "dependencies"]
    },
    {
      "description": "Label Prometheus packages",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^github\\.com\\/prometheus\\//"],
      "addLabels": ["metrics", "dependencies"]
    },
    {
      "description": "Label testcontainers packages",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^github\\.com\\/testcontainers\\//"],
      "addLabels": ["testing", "dependencies"]
    },
    {
      "description": "Label Goose migration packages",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^github\\.com\\/pressly\\/goose/"],
      "addLabels": ["database", "dependencies"]
    },
    {
      "description": "Label Cobra/Viper CLI packages",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^github\\.com\\/spf13\\//"],
      "addLabels": ["cli", "dependencies"]
    },
    {
      "description": "Label Go indirect dependencies",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "addLabels": ["indirect", "dependencies"]
    }
  ]
}
